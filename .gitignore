
# ============================================================
# SYCOPHANCY CLASSIFIER — .gitignore
# ============================================================

# --- Secrets and environment variables ---
.env
.env.*
!.env.example
.streamlit/secrets.toml

# --- Python bytecode and caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# --- Python build/package artifacts ---
build/
dist/
*.egg-info/
.eggs/
*.egg

# --- Python virtual environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Node.js / React / Vite ---
node_modules/
**/node_modules/
frontend/dist/
frontend/.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Visual Studio, IDE, and OS files ---
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db
tempCodeRunnerFile.py

# --- Trained models: store/transfer separately ---
model/final_model/
model/final_model_old/

# Large model/checkpoint files
*.safetensors
*.ckpt
*.pt
*.pth
*.bin

# --- Local datasets: store/transfer separately ---
data/
datasets/

# --- Generated experiment results ---
results/

# --- Local research notebooks ---
notebooks/
.ipynb_checkpoints/

# --- Logs and temporary files ---
*.log
*.tmp
*.temp
*.local
